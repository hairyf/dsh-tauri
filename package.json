{
  "name": "dsh-tauri",
  "version": "0.1.0",
  "description": "Native top nav bar plugin for DeepSeek Harness desktop: sidebar/back/forward route control plus minimize/maximize/background window controls, driven by iframe events to the Tauri host.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "plugin",
    "tauri",
    "deepseek-harness",
    "nav-bar"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hairyf/dsh-tauri.git"
  },
  "main": "lib/client.js",
  "exports": {
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.21.0",
    "@heroui/react": "^2.8.10"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
