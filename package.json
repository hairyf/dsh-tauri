{
  "name": "dsh-tauri",
  "version": "0.2.0",
  "description": "Message bridge for DeepSeek Harness desktop: forwards host nav-bar commands (sidebar toggle / page prev / page next) into dsh and reports dsh state back. No UI, no runtime dependencies.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh",
    "plugin",
    "tauri",
    "deepseek-harness",
    "bridge",
    "nav"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hairyf/dsh-tauri.git"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.node.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {},
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.7",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
